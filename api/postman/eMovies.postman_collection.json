{
  "info": {
    "_postman_id": "8a1ecbe4-999c-4e3d-8045-d817374fbf6d",
    "name": "eMovies API",
    "description": "End-to-end examples for the eMovies modular-monolith API. Run the requests in order with the eMovies Local environment selected. Authentication tokens, movie IDs, and review IDs are stored automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Health check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Confirms that the API and its database health checks are available."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API is healthy\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 - Get Keycloak token",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{clientId}}",
              "type": "text"
            },
            {
              "key": "username",
              "value": "{{username}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "text"
            },
            {
              "key": "grant_type",
              "value": "password",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{keycloakUrl}}/realms/emovies/protocol/openid-connect/token",
          "host": [
            "{{keycloakUrl}}"
          ],
          "path": [
            "realms",
            "emovies",
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "description": "Signs in as the local demo user and stores the returned access token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Token was issued\", function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
              "    pm.environment.set(\"accessToken\", body.access_token);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 - Create movie",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"The Matrix\",\n  \"description\": \"A computer hacker discovers the truth.\",\n  \"releaseDate\": \"1999-03-31\",\n  \"genre\": \"Science Fiction\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/movies",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies"
          ]
        },
        "description": "Creates a movie and stores its generated ID in movieId."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Movie was created\", function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a(\"string\").and.not.empty;",
              "    pm.environment.set(\"movieId\", body.id);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "04 - List movies",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/movies",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Movies were returned\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "05 - Get movie by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Movie was returned\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().id).to.eql(pm.environment.get(\"movieId\"));",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "06 - Update movie",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"The Matrix (Updated)\",\n  \"description\": \"A hacker learns that reality is a simulation.\",\n  \"releaseDate\": \"1999-03-31\",\n  \"genre\": \"Science Fiction\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Movie was updated\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().title).to.eql(\"The Matrix (Updated)\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "07 - Submit review",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5,\n  \"content\": \"Excellent movie.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}",
            "reviews"
          ]
        },
        "description": "Creates the demo user's one review for this movie and stores its ID."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Review was submitted for moderation\", function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(\"Pending\");",
              "    pm.environment.set(\"reviewId\", body.id);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "08 - Get moderation queue",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/moderation?status=Pending",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "moderation"
          ],
          "query": [
            {
              "key": "status",
              "value": "Pending"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pending reviews were returned\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "09 - Approve review",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"approve\": true,\n  \"reason\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/reviews/moderation/{{reviewId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "moderation",
            "{{reviewId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Review was approved\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql(\"Approved\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "10 - Get approved reviews",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}",
            "reviews"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Approved review is visible\", function () {",
              "    pm.response.to.have.status(200);",
              "    const reviews = pm.response.json();",
              "    pm.expect(reviews.some(review => review.id === pm.environment.get(\"reviewId\"))).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "11 - Get average movie rating",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}/rating",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}",
            "rating"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Average rating includes the approved review\", function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.averageRating).to.eql(5);",
              "    pm.expect(body.reviewCount).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "12 - Update own review",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 4,\n  \"content\": \"Still excellent after another viewing.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}/reviews/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}",
            "reviews",
            "me"
          ]
        },
        "description": "Updates the authenticated user's review. Editing returns it to Pending moderation."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Edited review returned to pending\", function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.rating).to.eql(4);",
              "    pm.expect(body.status).to.eql(\"Pending\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "13 - Approve edited review",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"approve\": true,\n  \"reason\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/reviews/moderation/{{reviewId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "moderation",
            "{{reviewId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Edited review was approved\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql(\"Approved\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "14 - Delete own review",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}/reviews/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}",
            "reviews",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Review was deleted\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "15 - Delete movie",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Movie was deleted\", function () {",
              "    pm.response.to.have.status(204);",
              "    pm.environment.unset(\"movieId\");",
              "    pm.environment.unset(\"reviewId\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ],
  "event": []
}
